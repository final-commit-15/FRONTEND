# Playwright Test Environment Configuration
# This file is used by Playwright for test configuration

# Frontend
BASE_URL=http://localhost:3000

# Backend API
API_URL=http://localhost:8000

# AI Services
AI_URL=http://localhost:8001

# Test Credentials
TEST_EMAIL=test@agentforge.ai
TEST_PASSWORD=password123

# Test Configuration
NODE_ENV=test
HEADLESS=true
CI=false

# Browser Configuration
BROWSER=chromium
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Timeouts
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=10000

# Visual Regression
UPDATE_SNAPSHOTS=false
THRESHOLD=0.2
MAX_DIFF_PIXELS=100

# API Test Credentials
API_TEST_TOKEN=
ADMIN_API_TOKEN=

# Feature Flags
ENABLE_VISUAL_TESTS=true
ENABLE_ACCESSIBILITY_TESTS=true
ENABLE_PERFORMANCE_TESTS=true
ENABLE_API_TESTS=true

# Mock Services
MOCK_AI_RESPONSES=true
MOCK_OAUTH=true
MOCK_STRIPE=true
MOCK_WEBHOOKS=true