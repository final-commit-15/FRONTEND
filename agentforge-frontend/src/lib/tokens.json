    "integration": {
      "slack": "#ff7aa8",
      "jira": "#7aafff",
      "calendar": "#8AB4F8",
      "github": "#fefefe",
      "notion": "#fefefe",
      "orbitFrom": "#fcd34d",
      "orbitTo": "#fff5e6"
