{
  "$schema": "agentforge.design-tokens/v1",
  "description": "AgentForge exported design tokens — exact palette. Shared by dashboard/settings. Do not edit hexes without design sign-off.",
  "dark": {
    "bg": {
      "primary": "#050508",
      "secondary": "#0a0a0f",
      "tertiary": "#111118",
      "card": "#0a0a0f",
      "surface": "#111118",
      "glass": "rgba(10,10,15,0.80)"
    },
    "text": {
      "primary": "#fefefe",
      "secondary": "#e4e4e7",
      "muted": "#8b8b96",
      "body": "#a1a1aa"
    },
    "border": {
      "primary": "#1e1e2a",
      "secondary": "#2a2a38"
